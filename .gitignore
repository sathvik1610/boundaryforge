# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Project Data (Ignore large raw inference artifacts, but track compiled output)
data/results.json
data/boundaries.json
data/timing.json

# IDEs
.vscode/
.idea/

# Internal Admin / Planning Docs (never expose publicly)
ADMIN.md
PLAN.md
Hackathon.md

# Auto-generated run backups (can be large)
data/backups/

# Gradio cache
.gradio/

# Large raw inference artifacts (not in original gitignore)
data/results_raw.jsonl
data/scored_results.json
data/probes.json

# Allow logs to be tracked
!logs/
