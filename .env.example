# Copy this file to .env and fill in your values
# Or export these as environment variables before running

# ==========================================
# 1. DEPLOYMENT MODE
# ==========================================
# Set to 'true' when deploying on the AMD MI300X instance.
# Set to 'false' for local Hugging Face testing.
USE_AMD_SERVER=true

# ==========================================
# 2. BATCH & PIPELINE SETTINGS
# ==========================================
# Production settings (runs when using `python main.py --production`)
PROBE_COUNT=2500
BATCH_SIZE=50
K_RUNS=3

# Test settings (runs by default on `python main.py`)
TEST_PROBE_COUNT=10
TEST_BATCH_SIZE=5
TEST_K_RUNS=1

# ==========================================
# 3. vLLM INFRASTRUCTURE
# ==========================================
# Port your vLLM server is running on (default: 8000)
VLLM_PORT=8000

# ==========================================
# 4. AUTHENTICATION & MODELS
# ==========================================
# HuggingFace token for vLLM weight downloads and local LiteLLM inference
HF_TOKEN=hf_your_token_here
HUGGINGFACE_API_KEY=${HF_TOKEN}

# AMD Production Models
MODEL_A=Qwen/Qwen2.5-72B-Instruct
MODEL_B=meta-llama/Meta-Llama-3-8B-Instruct

# Local Testing Models (Smaller)
LOCAL_MODEL_A=Qwen/Qwen2.5-7B-Instruct
LOCAL_MODEL_B=mistralai/Mistral-7B-Instruct-v0.3

# ==========================================
# 5. CONCURRENCY & vLLM TUNING
# ==========================================
# Start at 50 for first serious run with --max-model-len 8192 + max_tokens=512.
# Only increase to 100 after confirming no KV cache stalls on MI300X.
MAX_CONCURRENT=50

# How many top boundaries to pass into the compilation crew.
# K-Means then selects 15 representatives from this pool.
# Sending 100 gives K-Means real diversity to work with vs only 15.
MAX_COMPILER_INPUT=100

# Recommended vLLM launch flags:
#   --max-model-len 8192          # doubles context window for richer failure logs
#   --gpu-memory-utilization 0.90 # safe ceiling on MI300X 192GB
#   --dtype bfloat16              # memory efficient
